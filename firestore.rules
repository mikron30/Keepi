rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function isConversationParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function isNewConversationParticipant() {
      return signedIn()
        && request.auth.uid in request.resource.data.participantIds;
    }

    match /users/{userId} {
      allow read, create, update: if isUser(userId);
      allow delete: if false;
    }

    match /things/{thingId} {
      allow create: if ownsNewDocument();
      allow read: if ownsExistingDocument()
        || (signedIn() && resource.data.visibility == 'public');
      allow update, delete: if ownsExistingDocument();
    }

    match /conversations/{conversationId} {
      allow create: if isNewConversationParticipant();
      allow read, update: if isConversationParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        allow update, delete: if false;
      }
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || ownsExistingDocument();
      allow create: if ownsNewDocument();
      allow update, delete: if ownsExistingDocument();
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if ownsNewDocument();
      allow update, delete: if ownsExistingDocument();
    }

    match /bookings/{bookingId} {
      allow read, update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.renterId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.renterId == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
